AVOID_PERSISTENCE=<Disables state persistence>
DEBUG=<Enables debug engine and stores checkpoint and store to memory>
GOOGLE_API_KEY=<Api key used for Gemini>
LOCAL_OLLAMA_URL=<URL for the local Ollama server>
LOG_LEVEL=<Logging level>
LOG_LEVEL_AIOSQLITE=<aiosqlite logging level>
LOG_LEVEL_HTTP_CORE=<httpcore logging level>
NOTIFIER_URL=<URL for the user notification module>
STORE_EMBEDDINGS_MODEL=<Embedding model used in local store>
